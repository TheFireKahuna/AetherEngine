index 0000000..5635d9f
--- /dev/null
+++ b/dolby_vision/src/rpu/extension_metadata/tests.rs
@@ -0,0 +1,168 @@
+use anyhow::Result;
+
+use super::blocks::*;
+use super::{CmV29DmData, CmV40DmData, DmData, WithExtMetadataBlocks};
+use crate::rpu::dovi_rpu::DoviRpu;
+
+const FEL_ORIG: &[u8] = include_bytes!("../../../../assets/tests/fel_orig.bin");
+const CMV40_FULL: &[u8] = include_bytes!("../../../../assets/tests/cmv40_full_rpu.bin");
+const ST2094_10_L3: &[u8] = include_bytes!("../../../../assets/tests/st2094_10_level3.bin");
+
+fn cmv29(rpu: &mut DoviRpu) -> &mut CmV29DmData {
+    match rpu.vdr_dm_data.as_mut().unwrap().cmv29_metadata.as_mut().unwrap() {
+        DmData::V29(m) => m,
+        DmData::V40(_) => panic!("CM v4.0 data in the CM v2.9 slot"),
+    }
+}
+
+fn cmv40(rpu: &mut DoviRpu) -> &mut CmV40DmData {
+    match rpu.vdr_dm_data.as_mut().unwrap().cmv40_metadata.as_mut().unwrap() {
+        DmData::V40(m) => m,
+        DmData::V29(_) => panic!("CM v2.9 data in the CM v4.0 slot"),
+    }
+}
+
+fn reserved(level: u8, data: &[u8]) -> ExtMetadataBlock {
+    ExtMetadataBlock::Reserved(ReservedExtMetadataBlock {
+        ext_block_length: data.len() as u64,
+        ext_block_level: level,
+        data: data.to_vec(),
+    })
+}
+
+/// The assets are `extract-rpu` output: a start code, then the unspec62 payload with emulation prevention bytes.
+fn parse(source: &[u8]) -> Result<DoviRpu> {
+    DoviRpu::parse_unspec62_nalu(source)
+}
+
+/// Appends `block` to a list as it would arrive in a stream (no re-sorting), writes, and parses the result back.
+fn written_with<T: WithExtMetadataBlocks>(
+    source: &[u8],
+    list: fn(&mut DoviRpu) -> &mut T,
+    block: ExtMetadataBlock,
+) -> Result<(Vec<u8>, DoviRpu)> {
+    let mut rpu = parse(source)?;
+    let blocks = list(&mut rpu);
+    blocks.blocks_mut().push(block);
+    let count = blocks.blocks_ref().len() as u64;
+    blocks.set_num_ext_blocks(count);
+    rpu.modified = true;
+    let written = rpu.write_hevc_unspec62_nalu()?;
+    let reparsed = parse(&written)?;
+    Ok((written, reparsed))
+}
+
+fn last_reserved<T: WithExtMetadataBlocks>(list: &T) -> Option<&ReservedExtMetadataBlock> {
+    match list.blocks_ref().last() {
+        Some(ExtMetadataBlock::Reserved(b)) => Some(b),
+        _ => None,
+    }
+}
+
+#[test]
+fn unknown_level_is_carried_not_rejected() -> Result<()> {
+    let (written, mut reparsed) = written_with(FEL_ORIG, cmv29, reserved(7, &[0xAB, 0xCD, 0xEF]))?;
+
+    let block = last_reserved(cmv29(&mut reparsed)).expect("level 7 kept as a reserved block");
+    assert_eq!(block.ext_block_level, 7);
+    assert_eq!(block.data, [0xAB, 0xCD, 0xEF]);
+    assert_eq!(reparsed.write_hevc_unspec62_nalu()?, written);
+
+    Ok(())
+}
+
+#[test]
+fn cmv40_level_in_cmv29_list_is_carried() -> Result<()> {
+    // A one-byte L9 payload (source primaries index) where only the CM v4.0 list defines L9.
+    let (written, mut reparsed) = written_with(FEL_ORIG, cmv29, reserved(9, &[0x02]))?;
+
+    let block = last_reserved(cmv29(&mut reparsed)).expect("L9 in the v2.9 list kept as a reserved block");
+    assert_eq!(block.ext_block_level, 9);
+    assert_eq!(block.data, [0x02]);
+    assert_eq!(reparsed.write_hevc_unspec62_nalu()?, written);
+
+    Ok(())
+}
+
+#[test]
+fn unknown_level_in_cmv40_list_is_carried() -> Result<()> {
+    let (written, mut reparsed) = written_with(CMV40_FULL, cmv40, reserved(200, &[0x11, 0x22]))?;
+
+    let block = last_reserved(cmv40(&mut reparsed)).expect("level 200 kept as a reserved block");
+    assert_eq!(block.ext_block_level, 200);
+    assert_eq!(block.data, [0x11, 0x22]);
+    assert_eq!(reparsed.write_hevc_unspec62_nalu()?, written);
+
+    Ok(())
+}
+
+#[test]
+fn st2094_10_level3_in_cmv29_list_is_carried_byte_exact() -> Result<()> {
+    let mut rpu = parse(ST2094_10_L3)?;
+
+    let l3 = cmv29(&mut rpu)
+        .blocks_ref()
+        .iter()
+        .find_map(|b| match b {
+            ExtMetadataBlock::Reserved(r) if r.ext_block_level == 3 => Some(r.clone()),
+            _ => None,
+        })
+        .expect("the L3 in the CM v2.9 list is kept");
+    assert_eq!(l3.ext_block_length, 5, "ETSI TS 103 572: L3 is 5 bytes");
+
+    // The writer puts the 0x7C 0x01 NAL header in front; the asset starts with a 4-byte start code.
+    let written = rpu.write_hevc_unspec62_nalu()?;
+    let source = &ST2094_10_L3[4..];
+    let source = &source[..source.len() - source.iter().rev().take_while(|b| **b == 0).count()];
+    assert_eq!(&written[2..], source);
+
+    Ok(())
+}
+
+#[test]
+fn sixteen_l2_targets_accepted_seventeen_rejected() -> Result<()> {
+    let mut rpu = parse(FEL_ORIG)?;
+    let list = cmv29(&mut rpu);
+    let mut target = 100;
+    while list.blocks_ref().iter().filter(|b| b.level() == 2).count() < 16 {
+        list.replace_level2_block(&ExtMetadataBlockLevel2 {
+            target_max_pq: target,
+            ..Default::default()
+        });
+        target += 100;
+    }
+    rpu.modified = true;
+    let written = rpu.write_hevc_unspec62_nalu()?;
+    let reparsed = parse(&written)?;
+    assert_eq!(reparsed.write_hevc_unspec62_nalu()?, written);
+
+    cmv29(&mut rpu).replace_level2_block(&ExtMetadataBlockLevel2 {
+        target_max_pq: 4000,
+        ..Default::default()
+    });
+    assert!(rpu.write_hevc_unspec62_nalu().is_err(), "A/341 allows at most 16 L2 blocks");
+
+    Ok(())
+}
+
+#[test]
+fn reserved_length_past_the_payload_is_an_error_not_an_abort() -> Result<()> {
+    // A corrupt ue(v) length on a block this crate carries without interpreting: the writer emits what it is
+    // given, the parser has to refuse it before allocating.
+    let mut rpu = parse(FEL_ORIG)?;
+    let blocks = cmv29(&mut rpu);
+    blocks.blocks_mut().push(ExtMetadataBlock::Reserved(ReservedExtMetadataBlock {
+        ext_block_length: 1 << 40,
+        ext_block_level: 7,
+        data: vec![0xAB, 0xCD],
+    }));
+    let count = blocks.blocks_ref().len() as u64;
+    blocks.set_num_ext_blocks(count);
+    rpu.modified = true;
+    let written = rpu.write_hevc_unspec62_nalu()?;
+
+    let err = parse(&written).expect_err("a length past the payload must not parse");
+    assert!(format!("{err:#}").contains("exceeds the remaining data"), "{err:#}");
+
+    Ok(())
+}
