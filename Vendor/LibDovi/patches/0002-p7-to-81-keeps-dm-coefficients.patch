-        }
     }
 
     fn convert_to_p81_remove_mapping(&mut self) {
@@ -573,6 +572,10 @@ impl DoviRpu {
     fn convert_to_p84(&mut self) {
         self.convert_to_p81();
 
+        if let Some(vdr_dm_data) = self.vdr_dm_data.as_mut() {
+            vdr_dm_data.set_p81_coeffs();
+        }
